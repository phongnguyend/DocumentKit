<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Read, inspect, edit and write PPTX packages.</Description>
    <Authors>Phong Nguyen</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/phongnguyend/DocumentKit</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PptxObjectKit.Extensions.Pdf" />
    <InternalsVisibleTo Include="PptxObjectKit.Extensions.Markdown" />
  </ItemGroup>
</Project>
