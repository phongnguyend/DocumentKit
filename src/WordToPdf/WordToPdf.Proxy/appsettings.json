{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "libreoffice-route": {
        "ClusterId": "libreoffice-cluster",
        "Match": {
          "Path": "/libreoffice/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/libreoffice"
          }
        ]
      },
      "docxobjectkit-route": {
        "ClusterId": "docxobjectkit-cluster",
        "Match": {
          "Path": "/docxobjectkit/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/docxobjectkit"
          }
        ]
      }
    },
    "Clusters": {
      "libreoffice-cluster": {
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        },
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:62820/"
          }
        }
      },
      "docxobjectkit-cluster": {
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        },
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:62821/"
          }
        }
      }
    }
  }
}
