<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Authors>Phong Nguyen</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>markdown;documents;converter</PackageTags>
    <RepositoryUrl>https://github.com/phongnguyend/DocumentKit</RepositoryUrl>
    <Description>Markdown conversion for PptxObjectKit.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PptxObjectKit/PptxObjectKit.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
